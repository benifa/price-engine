# Ollama Modelfile for the list-price specialist (after LoRA → GGUF export).
# Replace the FROM path with your converted GGUF, then:
#   ollama create list-price -f Modelfile
#
# See docs/OLLAMA.md. Training source of truth remains the Hub PEFT adapter.

FROM ./list-price-qlora.gguf

TEMPLATE """{{ .Prompt }}"""

SYSTEM """You estimate Amazon-style list prices in whole dollars from product text.
When the user prompt ends with "Price is $", continue with NNN.00 only."""

PARAMETER temperature 0.0
PARAMETER num_predict 8
PARAMETER stop "\n"
